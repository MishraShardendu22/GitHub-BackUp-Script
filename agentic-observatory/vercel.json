{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "headers": [
    {
      "source": "/chat/stream(.*)",
      "headers": [
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-transform"
        }
      ]
    }
  ]
}

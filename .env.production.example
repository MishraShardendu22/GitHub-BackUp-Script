# ==============================================================================
# GitHub Backup Automation System — Production Environment Template
# ==============================================================================
# Production environment uses primary Neon 'production' database branch.
# ==============================================================================

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@ep-production-branch.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://DB_USER:DB_PASSWORD@ep-production-branch.us-east-1.aws.neon.tech/neondb?sslmode=require

INTERNAL_SECRET=production_secure_internal_secret_32_chars_min
JWT_SECRET=production_secure_jwt_signing_secret_32_chars_min
OPENROUTER_API_KEY=your_production_openrouter_key_1,your_production_openrouter_key_2

GO_BACKEND_URL=https://github-backup-backend.onrender.com
NEXT_PUBLIC_AI_AGENT_URL=https://git-hub-backup-automation-system.vercel.app
NEXT_PUBLIC_API_URL=https://github-backup-backend.onrender.com

GITHUB_TOKEN=your_production_github_token_here
BACKUP_DIR=/tmp/github-backups-production

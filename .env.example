# ==============================================================================
# GitHub Backup Automation System — Root .env.example
# ==============================================================================
# This file shows ALL environment variables needed across the entire Docker
# Compose stack (docker compose up). Each service also has its own .env file.
#
# Copy this to guide creation of individual service .env files:
#   - backend/.env
#   - agentic-observatory/.env
#   - backup-worker/.env
#   - frontend/.env.local (for Next.js)
#
# NEVER commit real secrets. This file contains only example placeholders.
# ==============================================================================

# ── Shared ────────────────────────────────────────────────────────────────────

# PostgreSQL (Neon or any PostgreSQL 16+ with pgvector)
# Go backend format:
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Python Observatory format (asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Shared secret between Go Backend and Python Observatory
INTERNAL_SECRET=your-internal-secret-here

# ── Go Backend (backend/.env) ─────────────────────────────────────────────────

SERVER_PORT=8080
LOG_LEVEL=info
# DATABASE_URL= (see above)
# INTERNAL_SECRET= (see above)
OPENROUTER_API_KEY=your-openrouter-key-1,your-openrouter-key-2

# ── Python Observatory (agentic-observatory/.env) ─────────────────────────────

GO_BACKEND_URL=http://backend:8080   # Docker Compose internal network
# DATABASE_URL= (asyncpg format, see above)
# INTERNAL_SECRET= (see above)
# OPENROUTER_API_KEY= (see above, comma-separated for failover)
JWT_SECRET=your-jwt-secret-here
CHAT_USERNAME=admin
CHAT_PASSWORD=your-chat-password-here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=recipient@example.com

# ── Backup Worker (backup-worker/.env) ────────────────────────────────────────

ORG_ACCOUNT=your-github-org
PROJECT_ACCOUNT=your-github-username
GITHUB_TOKEN_PERSONAL=ghp_your_personal_token
GITHUB_TOKEN_PRIVATE=ghp_your_private_token
BACKUP_REPO_PATH=git@github.com:your-username/your-backup-repo.git
DB_PATH=./app.db
# DATABASE_URL= (see above)

# ── Frontend (frontend/.env.local) ────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

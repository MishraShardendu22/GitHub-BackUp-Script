# ==============================================================================
# GitHub Backup Automation System — Master Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development with Docker Compose or native tooling.
#
# Environment Profiles:
#   Development: Uses Neon "development" branch or local DB
#   Staging:     Uses Neon "staging" branch (.env.staging.example)
#   Production:  Uses Neon "production" branch (.env.production.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon pgvector)
# ------------------------------------------------------------------------------
# Point to your development PostgreSQL or Neon database branch:
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@ep-development-branch.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://DB_USER:DB_PASSWORD@ep-development-branch.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication & Inter-Service Security
# ------------------------------------------------------------------------------
# Shared secret for Go Backend <-> Python Observatory internal communication (min 32 chars):
INTERNAL_SECRET=your_secure_internal_shared_secret_32_chars_min

# JWT Secret for dashboard session tokens:
JWT_SECRET=your_secure_jwt_signing_secret_32_chars_min

# ------------------------------------------------------------------------------
# 3. AI & OpenRouter Multi-Key Pool (Python Observatory & Embeddings)
# ------------------------------------------------------------------------------
# Comma-separated OpenRouter API keys for resilient automatic failover:
OPENROUTER_API_KEY=your_openrouter_api_key_1,your_openrouter_api_key_2

# ------------------------------------------------------------------------------
# 4. Service Endpoints & Routing
# ------------------------------------------------------------------------------
# URL for Go Backend API:
GO_BACKEND_URL=http://localhost:8080
# URL for Python AI Observatory:
NEXT_PUBLIC_AI_AGENT_URL=http://localhost:8000
# URL for Next.js Frontend Dashboard:
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Backup Engine Settings (Worker CLI)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
BACKUP_DIR=/tmp/github-backups

# ==============================================================================
# GitHub Backup Automation System — Staging Environment Template
# ==============================================================================
# Staging environment uses Neon 'staging' database branch and preview URLs.
# ==============================================================================

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@ep-staging-branch.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://DB_USER:DB_PASSWORD@ep-staging-branch.us-east-1.aws.neon.tech/neondb?sslmode=require

INTERNAL_SECRET=staging_internal_secret_32_chars_min
JWT_SECRET=staging_jwt_signing_secret_32_chars_min
OPENROUTER_API_KEY=your_staging_openrouter_key_1,your_staging_openrouter_key_2

GO_BACKEND_URL=https://github-backup-backend-staging.onrender.com
NEXT_PUBLIC_AI_AGENT_URL=https://git-hub-backup-automation-system-staging.vercel.app
NEXT_PUBLIC_API_URL=https://github-backup-backend-staging.onrender.com

GITHUB_TOKEN=your_staging_github_token_here
BACKUP_DIR=/tmp/github-backups-staging

#!/usr/bin/env bash
# ==============================================================================
# GitHub Backup Automation System — Intelligent Pre-Commit Gate
# ==============================================================================
# This hook performs automated code validation before commits:
# 1. Detects staged changes and selectively executes targeted checks.
# 2. Enforces code formatting (gofmt, Biome).
# 3. Runs static analysis & type checking (go vet, pyright, Biome).
# 4. Executes unit, integration, and AI agent test suites.
# 5. Verifies production builds (Go binaries, Next.js frontend).
# 6. Aborts immediately on failure with clear remediation guidance.
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Configuration & Color Formatting
# ------------------------------------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

if [ -t 1 ]; then
    BOLD="\033[1m"
    DIM="\033[2m"
    RED="\033[1;31m"
    GREEN="\033[1;32m"
    YELLOW="\033[1;33m"
    BLUE="\033[1;34m"
    MAGENTA="\033[1;35m"
    CYAN="\033[1;36m"
    RESET="\033[0m"
else
    BOLD=""
    DIM=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    MAGENTA=""
    CYAN=""
    RESET=""
fi

START_TIME=$(date +%s)
FAILED_STEPS=()
PASSED_STEPS=()
SKIPPED_STEPS=()

print_banner() {
    echo -e "${CYAN}======================================================================${RESET}"
    echo -e "${BOLD}${MAGENTA}  GitHub Backup Automation System — Pre-Commit Validation Gate${RESET}"
    echo -e "${CYAN}======================================================================${RESET}"
}

log_info() {
    echo -e "${BLUE}ℹ [INFO]${RESET} $*"
}

log_step() {
    echo -e "\n${BOLD}${CYAN}▶ [STEP]${RESET} ${BOLD}$*${RESET}"
}

log_pass() {
    echo -e "${GREEN}✔ [PASS]${RESET} $*"
}

log_warn() {
    echo -e "${YELLOW}▲ [WARN]${RESET} $*"
}

log_fail() {
    echo -e "${RED}✖ [FAIL]${RESET} $*"
}

# ------------------------------------------------------------------------------
# Check for Bypasses & Overrides
# ------------------------------------------------------------------------------
if [ "${SKIP_HOOKS:-0}" = "1" ] || [ "${PRECOMMIT_BYPASS:-0}" = "1" ]; then
    log_warn "Pre-commit validations bypassed via SKIP_HOOKS=1 or PRECOMMIT_BYPASS=1."
    exit 0
fi

# ------------------------------------------------------------------------------
# Detect Staged Changes & Affected Subsystems
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

CHECK_GO=0
CHECK_PY=0
CHECK_FE=0
CHECK_ALL=0

if [ -z "${STAGED_FILES}" ] || [ "${PRECOMMIT_ALL:-0}" = "1" ]; then
    # Direct execution or full validation requested
    CHECK_ALL=1
    CHECK_GO=1
    CHECK_PY=1
    CHECK_FE=1
    MODE_DESC="Full Repository Validation (All Subsystems)"
else
    # Inspect individual file paths
    while IFS= read -r file; do
        [ -z "$file" ] && continue

        # Go files (Backup worker CLI, backend API, shared modules)
        if [[ "$file" =~ \.go$ ]] || [[ "$file" =~ ^(go\.mod|go\.sum|backend/|backup-worker/) ]]; then
            CHECK_GO=1
        fi

        # Python Observatory (FastAPI, AI agent, data, migrations)
        if [[ "$file" =~ ^agentic-observatory/ ]] || [[ "$file" =~ \.py$ ]] || [[ "$file" == "pyrightconfig.json" ]]; then
            CHECK_PY=1
        fi

        # Next.js Frontend (React, TypeScript, UI components)
        if [[ "$file" =~ ^frontend/ ]]; then
            CHECK_FE=1
        fi

        # Global infrastructure files (Makefile, CI workflows, hooks, scripts)
        if [[ "$file" =~ ^(\.github/|\.githooks/|scripts/|Makefile) ]]; then
            CHECK_ALL=1
            CHECK_GO=1
            CHECK_PY=1
            CHECK_FE=1
        fi
    done <<< "${STAGED_FILES}"

    # Check if only non-code files changed (docs, markdown, text, assets)
    if [ "$CHECK_GO" -eq 0 ] && [ "$CHECK_PY" -eq 0 ] && [ "$CHECK_FE" -eq 0 ] && [ "$CHECK_ALL" -eq 0 ]; then
        DOC_ONLY=1
        while IFS= read -r file; do
            [ -z "$file" ] && continue
            if ! [[ "$file" =~ \.(md|txt|png|jpg|jpeg|svg|gitignore|env\.example)$ ]]; then
                DOC_ONLY=0
                break
            fi
        done <<< "${STAGED_FILES}"

        if [ "$DOC_ONLY" -eq 1 ]; then
            print_banner
            log_info "Only documentation and asset files changed. Skipping heavy compilation and test suites."
            log_pass "Documentation validation successful."
            exit 0
        fi

        # Default fallback to all checks if unrecognized files exist
        CHECK_ALL=1
        CHECK_GO=1
        CHECK_PY=1
        CHECK_FE=1
    fi

    MODE_DESC="Targeted Validation (Staged Changes Detected)"
fi

print_banner
log_info "Mode: ${BOLD}${MODE_DESC}${RESET}"
log_info "Selected checks: Go Backend/Worker: $([ $CHECK_GO -eq 1 ] && echo -e "${GREEN}YES${RESET}" || echo -e "${DIM}NO${RESET}") | Python Observatory: $([ $CHECK_PY -eq 1 ] && echo -e "${GREEN}YES${RESET}" || echo -e "${DIM}NO${RESET}") | Next.js Frontend: $([ $CHECK_FE -eq 1 ] && echo -e "${GREEN}YES${RESET}" || echo -e "${DIM}NO${RESET}")"

# ------------------------------------------------------------------------------
# Helper: Run Step with Subshell Isolation, Timing & Error Handling
# ------------------------------------------------------------------------------
run_validation_step() {
    local step_name="$1"
    local cmd="$2"
    local remediation="$3"

    log_step "${step_name}"
    local step_start
    step_start=$(date +%s)

    if ( cd "${REPO_ROOT}" && eval "${cmd}" ); then
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_pass "${step_name} (${elapsed}s)"
        PASSED_STEPS+=("${step_name}")
    else
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_fail "${step_name} failed after ${elapsed}s"
        FAILED_STEPS+=("${step_name}")
        echo -e "\n${RED}${BOLD}Commit Aborted!${RESET} The step '${step_name}' did not pass."
        if [ -n "${remediation}" ]; then
            echo -e "${YELLOW}Suggested fix:${RESET} ${remediation}"
        fi
        exit 1
    fi
}

# ==============================================================================
# PHASE 1: Go Backend & Worker Validation
# ==============================================================================
if [ "$CHECK_GO" -eq 1 ]; then
    # 1.1 Check Go formatting
    check_gofmt() {
        local unformatted=""
        if [ -n "${STAGED_FILES}" ] && [ "$CHECK_ALL" -eq 0 ]; then
            local staged_go
            staged_go=$(echo "${STAGED_FILES}" | grep '\.go$' || true)
            if [ -n "${staged_go}" ]; then
                unformatted=$(gofmt -l ${staged_go})
            fi
        else
            unformatted=$(gofmt -l . 2>/dev/null | grep -v '^frontend/' | grep -v '^agentic-observatory/' || true)
        fi

        if [ -n "${unformatted}" ]; then
            echo -e "${RED}The following Go files are not formatted properly:${RESET}"
            echo "${unformatted}"
            return 1
        fi
        return 0
    }

    run_validation_step \
        "Go Code Formatting (gofmt)" \
        "check_gofmt" \
        "Run 'gofmt -w <file>' or 'make format' to format Go source code."

    # 1.2 Go Static Analysis & Vet
    run_validation_step \
        "Go Static Analysis (go vet)" \
        "go vet ./..." \
        "Fix compiler warnings and static analysis issues reported by 'go vet ./...'."

    # 1.3 Go Unit & Integration Tests
    if [ "${SKIP_TESTS:-0}" != "1" ]; then
        run_validation_step \
            "Go Backend & Worker Test Suite" \
            "go test -v ./..." \
            "Review failed Go unit tests with 'go test -v ./...'."
    else
        log_warn "Go test suite skipped via SKIP_TESTS=1"
        SKIPPED_STEPS+=("Go Test Suite")
    fi

    # 1.4 Go Binaries Build Check
    if [ "${SKIP_BUILDS:-0}" != "1" ]; then
        run_validation_step \
            "Go Binaries Build (Worker CLI & Fiber Server)" \
            "go build -v ./..." \
            "Check Go compilation errors with 'go build -v ./...'."
    else
        log_warn "Go build check skipped via SKIP_BUILDS=1"
        SKIPPED_STEPS+=("Go Build")
    fi
fi

# ==============================================================================
# PHASE 2: Python Agentic Observatory Validation
# ==============================================================================
if [ "$CHECK_PY" -eq 1 ]; then
    # 2.1 Python Static Type Check (Pyright via uv)
    run_validation_step \
        "Python Static Type Check (Pyright)" \
        "cd agentic-observatory && uv run --with pyright pyright" \
        "Fix type errors in Python observatory codebase reported by 'uv run --with pyright pyright'."

    # 2.2 Python Observatory & AI Agent Test Suite
    if [ "${SKIP_TESTS:-0}" != "1" ]; then
        run_validation_step \
            "Python Observatory & AI Agent Test Suite" \
            "cd agentic-observatory && \
             OPENROUTER_API_KEY=\"\${OPENROUTER_API_KEY:-test-precommit-key}\" \
             INTERNAL_SECRET=\"\${INTERNAL_SECRET:-test-precommit-secret}\" \
             JWT_SECRET=\"\${JWT_SECRET:-test-precommit-jwt}\" \
             GO_BACKEND_URL=\"\${GO_BACKEND_URL:-http://localhost:8080}\" \
             uv run python test_observability.py && \
             uv run python test_openrouter_keys.py && \
             uv run python test_agent_template.py && \
             uv run python test_agent_suite.py" \
            "Run Python test suites locally via 'make test-py' and inspect failures."
    else
        log_warn "Python test suite skipped via SKIP_TESTS=1"
        SKIPPED_STEPS+=("Python Observatory Test Suite")
    fi
fi

# ==============================================================================
# PHASE 3: Next.js Frontend Validation
# ==============================================================================
if [ "$CHECK_FE" -eq 1 ]; then
    # 3.1 Biome Linter & Formatter Check
    run_validation_step \
        "Frontend Linter & Formatter (Biome)" \
        "cd frontend && pnpm run lint" \
        "Run 'cd frontend && pnpm run format' to automatically fix formatting issues."

    # 3.2 Next.js Turbopack & TypeScript Production Build
    if [ "${SKIP_BUILDS:-0}" != "1" ]; then
        run_validation_step \
            "Next.js Frontend Build & TypeScript Validation" \
            "cd frontend && pnpm run build" \
            "Inspect frontend build and TypeScript errors via 'cd frontend && pnpm run build'."
    else
        log_warn "Frontend build skipped via SKIP_BUILDS=1"
        SKIPPED_STEPS+=("Frontend Build")
    fi
fi

# ==============================================================================
# Summary & Success
# ==============================================================================
END_TIME=$(date +%s)
TOTAL_TIME=$((END_TIME - START_TIME))

echo -e "\n${CYAN}======================================================================${RESET}"
echo -e "${GREEN}${BOLD}✔ Pre-Commit Gate: All Validations Passed Successfully! (${TOTAL_TIME}s)${RESET}"
echo -e "${CYAN}======================================================================${RESET}"
echo -e "  Passed checks (${#PASSED_STEPS[@]}): ${GREEN}${PASSED_STEPS[*]}${RESET}"
if [ ${#SKIPPED_STEPS[@]} -gt 0 ]; then
    echo -e "  Skipped checks (${#SKIPPED_STEPS[@]}): ${YELLOW}${SKIPPED_STEPS[*]}${RESET}"
fi
echo -e "${CYAN}======================================================================${RESET}\n"

exit 0
